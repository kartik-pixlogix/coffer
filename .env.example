APP_NAME=Coffer
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 is the target (MariaDB 10.4+ works locally, e.g. XAMPP).
# Keep migrations portable: no engine-specific column types or SQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coffer
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Locally the database queue is fine; production uses redis + Horizon.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@coffer.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google sign-in (Socialite, Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Credentials Vault (Phase 7, spec section 14.3). Never commit real values.
# VAULT_MASTER_KEY wraps each company's data key (AES-256-GCM): 32 random bytes,
# base64-encoded with a base64: prefix. Generate both keys with: php artisan coffer:vault-key
# (it prints them; nothing is written). Keep a safe copy: without it the vault can't be opened.
VAULT_MASTER_KEY=
# Master-key rotation: old keys here (comma-separated), then php artisan coffer:vault-rotate --master
VAULT_PREVIOUS_MASTER_KEYS=
# Separate HMAC key for password-reuse fingerprints. Must differ from the master key.
VAULT_FINGERPRINT_KEY=
# Have I Been Pwned range API (k-anonymity) breach checks; opt-in per workspace.
VAULT_HIBP_ENABLED=false

# Billing: Stripe via Laravel Cashier (Phase 8, spec section 20, D80). The workspace is the
# Stripe customer. Use TEST-mode keys (pk_test_/sk_test_) locally; see docs/BILLING_TESTING.md.
STRIPE_KEY=
STRIPE_SECRET=
# From `stripe listen --forward-to localhost:8000/stripe/webhook` locally, or the
# Dashboard's webhook endpoint in production (whsec_...).
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=inr
CASHIER_CURRENCY_LOCALE=en_IN
# Stripe Price ids (price_...) per plan, cycle and currency. Empty = that option can't be
# bought yet (the Upgrade modal says so). Enterprise is priced by the team, never here.
STRIPE_PRICE_STARTER_MONTHLY_INR=
STRIPE_PRICE_STARTER_YEARLY_INR=
STRIPE_PRICE_STARTER_MONTHLY_USD=
STRIPE_PRICE_STARTER_YEARLY_USD=
STRIPE_PRICE_GROWTH_MONTHLY_INR=
STRIPE_PRICE_GROWTH_YEARLY_INR=
STRIPE_PRICE_GROWTH_MONTHLY_USD=
STRIPE_PRICE_GROWTH_YEARLY_USD=
STRIPE_PRICE_BUSINESS_MONTHLY_INR=
STRIPE_PRICE_BUSINESS_YEARLY_INR=
STRIPE_PRICE_BUSINESS_MONTHLY_USD=
STRIPE_PRICE_BUSINESS_YEARLY_USD=
# Plans and trial (D80, D81): the no-card trial length and plan, the days a past-due or
# expired workspace stays writable, and the default billing currency (inr or usd).
BILLING_GATEWAY=stripe
BILLING_TRIAL_DAYS=14
BILLING_TRIAL_PLAN=growth
BILLING_GRACE_DAYS=7
BILLING_CURRENCY=inr

# Razorpay: not built yet (spec section 20 "a later option", D80 [VERIFY]). Reserved keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications (D78): "Settlement due" fires when one JV side owes another at least this
# much, in paise (1000000 = Rs 10,000). Mail uses the Coffer brand Markdown theme.
SETTLEMENT_DUE_THRESHOLD_PAISE=1000000
MAIL_MARKDOWN_THEME=coffer

# Largest amount a money field accepts, in paise (F1): ₹100 crore.
MONEY_MAX_PAISE=100000000000

VITE_APP_NAME="${APP_NAME}"

# The QA sweep server only (docs/QA.md): a missing file makes it ignore public/hot. Leave empty.
VITE_HOT_FILE=

# Reports (D61): periods with more journal lines than this export through a queued job.
REPORTS_QUEUE_EXPORTS_OVER_LINES=20000

# Marketing site (D83, D84): Contact / Book a demo requests are stored and emailed (queued)
# to this address; submissions allowed per IP per hour.
MARKETING_CONTACT_EMAIL=sales@coffer.test
MARKETING_CONTACT_PER_HOUR=5

# Super-admin panel at /admin (D85): `php artisan coffer:platform-admin` creates the first
# platform admin from these (or asks). Platform admins are not tenant users.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_MFA_REQUIRED=true

# Security headers (D93). HSTS is sent in production only. Report-only tries a CSP change live.
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_CSP_REPORT_URI=
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_PRELOAD=false
# Secure (HTTPS-only) session cookies default on in production; set explicitly to override.
# SESSION_SECURE_COOKIE=

# Horizon (D95): production queues run on Redis (QUEUE_CONNECTION=redis); /horizon is for
# platform admins. Long-wait alerts go to this address.
HORIZON_NOTIFY_EMAIL=
HORIZON_APP_PROCESSES=4
HORIZON_HEAVY_PROCESSES=2
# HORIZON_PATH=horizon
# HORIZON_DOMAIN=
# HORIZON_NAME=
# HORIZON_PREFIX=
# Longer than the longest job (600 s), so a running import is never handed to a second worker.
REDIS_QUEUE_RETRY_AFTER=660
DB_QUEUE_RETRY_AFTER=660

# Backups (D96): `php artisan coffer:backup`, nightly. AES-256 ZIP password (16+ characters,
# required; keep it with VAULT_MASTER_KEY). Use an off-site disk in production.
BACKUP_PASSWORD=
BACKUP_DISK=backups
BACKUP_PATH=coffer
BACKUP_KEEP_DAYS=14
BACKUP_TIMEOUT=1800
# Full paths when not on PATH, e.g. C:/xampp/mysql/bin/mysqldump.exe
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_PG_DUMP_PATH=pg_dump

# Health and errors (D97): GET /health with "Authorization: Bearer <token>" (or a platform admin).
HEALTH_CHECK_TOKEN=
# Only with `composer require sentry/sentry-laravel` (docs/DEPLOY.md); errors go to the log otherwise.
SENTRY_LARAVEL_DSN=

# DPDPA (D98): days before a requested account / workspace deletion is carried out, and how long
# an export's download link lasts.
PRIVACY_GRACE_DAYS=30
PRIVACY_EXPORT_TTL_DAYS=7
PRIVACY_EXPORT_DISK=local


# CASHIER_PAPER=a4
# CASHIER_INVOICE_RENDERER=
# CASHIER_LOGGER=
# CASHIER_PAYMENT_NOTIFICATION=
# CASHIER_REMOTE_ENABLED=
# STRIPE_WEBHOOK_TOLERANCE=300
